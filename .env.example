# Servidor
# PORT=3000
# PERSISTENCE=memory

# Base de datos (PostgreSQL/Supabase)
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Autenticación JWT
JWT_SECRET=cambia_este_secreto
JWT_EXPIRES_IN=30m

# Correo transaccional (Gmail SMTP)
# MAIL_PASSWORD debe ser una "contraseña de aplicación" de Google / MAIL_USER debe ser el correo de Gmail
# (Cuenta de Google > Seguridad > Contraseñas de aplicación).
MAIL_USER=
MAIL_PASSWORD=


# Recuperación de contraseña
PASSWORD_RESET_URL=dispensador://reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_SECRET=cambia_este_secreto_de_recuperacion
