
# Persistencia: 'db' (PostgreSQL, por defecto) o 'memory' (desarrollo/pruebas)
PERSISTENCE_DRIVER=db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pet_dispenser
DB_SCHEMA=public
DB_SYNCHRONIZE=false

# Puerto HTTP
PORT=3000

# Broker MQTT. Si no está definido, el backend arranca solo en HTTP
# (sin microservicio MQTT ni publicación de comandos).
# Local: mqtt:// se permite; remoto: exige mqtts:// + MQTT_USERNAME/MQTT_PASSWORD.
MQTT_URL=mqtt://127.0.0.1:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_CA_FILE=./mqtt/ca.crt

# Supabase (autenticación)
SUPABASE_URL=https://proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu-publishable-key
